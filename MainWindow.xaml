<Window x:Class="IndustrialDataLogger.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IndustrialDataLogger.Wpf"
        mc:Ignorable="d"
        Title="工业数据采集系统" Height="450" Width="800">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!--上半：实时监控-->
        <GroupBox Header="实时监控" Grid.Row="0" Margin="0,0,0,10" Padding="10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="温度：" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding CurrentTemperature}" 
                           FontSize="24" FontWeight="Bold" Margin="5,0,5,0"/>
                <TextBlock Text="℃" VerticalAlignment="Center" Margin="0,0,20,0"/>

                <TextBlock Text="压力：" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding CurrentPressure}" 
           FontSize="24" FontWeight="Bold" Margin="5,0,5,0"/>
                <TextBlock Text="MPa" VerticalAlignment="Center" Margin="0,0,20,0"/>

                <TextBlock Text="状态" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding DeviceStatus}" FontWeight="Bold"
                           Foreground="Green" Margin="5,0,30,0"/>

                <Button Content="开始监控" Command="{Binding StartMonitoringCommand}"
                        Padding="15,8" Margin="0,0,10,0"/>
                <Button Content="停止监控" Command="{Binding StopMonitoringCommand}"
                        Padding="15,8" />
            </StackPanel>
        </GroupBox>
        
        <!--中间：历史查询条件-->
        <GroupBox Header="历史查询" Grid.Row="1" Margin="0,0,0,10" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="设备ID：" VerticalAlignment="Center"/>
                <TextBox Text="{Binding QueryDeviceId}" Width="100"
                         Margin="5,0,15,0" VerticalAlignment="Center"/>
                <TextBlock Text="起始：" VerticalAlignment="Center"/>
                <DatePicker SelectedDate="{Binding QueryStartDate}"
                            Width="130" Margin="5,0,15,0"/>
                <TextBlock Text="结束：" VerticalAlignment="Center"/>
                <DatePicker SelectedDate="{Binding QueryEndDate}"
            Width="130" Margin="5,0,15,0"/>
                <Button Content="查询" Command="{Binding QueryHistoryCommand}" Padding="15,5"/>
            </StackPanel>
        </GroupBox>
        
        <!--下半：历史数据表格-->
        <DataGrid Grid.Row="2" ItemsSource="{Binding HistoryList}"
                  AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="设备ID" Binding="{Binding DeviceId}" Width="100"/>
                <DataGridTextColumn Header="温度(℃)" Binding="{Binding Temperature}" Width="100"/>
                <DataGridTextColumn Header="压力(MPa)" Binding="{Binding Pressure}" Width="100"/>
                <DataGridTextColumn Header="记录时间)" Binding="{Binding RecordTime}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
